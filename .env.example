# ── SitRep Security & Authentication ───────────────────────────────────
# SitRep signing secret (from Studio when creating a Remote agent)
SITREP_AGENT_SECRET=
SITREP_SIGNATURE_MAX_AGE=300

# ── Primary LLM Provider (Google AI Studio / Gemini API) ─────────────
# Preferred Provider: Google AI Studio API (Gemini 3.5 & 3.1 Flash Lite)
GEMINI_API_KEY="your_api_key"
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_SECONDARY_MODEL=gemini-3.1-flash-lite

# ── Secondary LLM Provider (OpenRouter / Groq / OpenAI / Ollama) ──────
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY="your_api_key"
MODEL=meta-llama/llama-3.3-70b-instruct

# ── LLM Multi-Provider Failover Settings ──────────────────────────────
FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct,meta-llama/llama-3.1-70b-instruct,mistralai/mistral-small-24b-instruct-2501
FALLBACK_BASE_URL=http://localhost:11434/v1
FALLBACK_API_KEY=

# ── Memory & Vector Storage ───────────────────────────────────────────
MEMORY_DB_PATH=./agent_memory.db
VECTOR_DB_PATH=./vector_memory_store.json

# ── External MCP Server Client ─────────────────────────────────────────
MCP_SERVER_URLS=https://mcp.smithery.run/your_username
MCP_API_TOKEN="your_token"
# MCP_API_TOKENS=Bearer token1,Bearer token2
# MCP_SERVER_AUTH='{"https://mcp.smithery.run/your_username": "Bearer your_token"}'

# ── Email Sender (Resend / SendGrid) ──────────────────────────────────
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....
SENDER_EMAIL=notifications@example.com
SENDER_NAME="SitRep Meeting Orchestrator"

# ── Linear Ticket Creator ──────────────────────────────────────────────
# LINEAR_API_KEY=lin_api_...
# LINEAR_TEAM_ID=ENG

# ── HubSpot CRM Logger ────────────────────────────────────────────────
# HUBSPOT_API_KEY=pat-na1-...
# HUBSPOT_ACCESS_TOKEN=pat-na1-...

# ── Slack Messenger ───────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=#general

# ── Notion Page Creator ───────────────────────────────────────────────
# NOTION_TOKEN=secret_...
# NOTION_DATABASE_ID=...

# ── Jira Ticket Creator ───────────────────────────────────────────────
# JIRA_BASE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=...
# JIRA_PROJECT_KEY=PROJ
# JIRA_ISSUE_TYPE=Task

# ── Google Calendar API ───────────────────────────────────────────────
GOOGLE_CALENDAR_CREDENTIALS_JSON=
GOOGLE_CALENDAR_CREDENTIALS_PATH=./service-account.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_ACCESS_TOKEN=
